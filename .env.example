# Copy to .env.local. Values come from the Supabase dashboard of the
# environment you target (cogni-dev locally and in previews, cogni-prod only
# in Vercel production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Transaction pooler URL (port 6543). prepare: false is set in code.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Private Supabase Storage buckets, created by migrations 0004 and 0006.
# Not secrets: the same names in every environment.
SUPABASE_STORAGE_BUCKET=page-assets
SUPABASE_PDF_BUCKET=page-pdfs
# Bearer for GET /api/keep-alive (Vercel Cron). At least 32 random chars:
#   openssl rand -hex 32
CRON_SECRET=
# Observability (optional locally). Server DSN and public DSN are usually equal.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# AI layer (documento-maestro §8). Server only, never NEXT_PUBLIC_*.
# AI_PROVIDER_MODE=fake needs none of the keys below (CI, e2e).
AI_PROVIDER_MODE=live
# Need at least one generation provider: Google, OpenRouter or Cloudflare
# (account id + token together). Groq is used for evaluation only.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENROUTER_API_KEY=
# Single free Upstash Redis database; prefix cogni:dev locally, cogni:prod in prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=cogni:dev
# Optional limits (defaults: 6 generations per user per day, 12000-token page cap).
AI_DAILY_GENERATIONS=6
AI_PAGE_TOKEN_CAP=12000
