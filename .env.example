# Copy to .env.local. Values come from the Supabase dashboard of the
# environment you target (cogni-dev locally and in previews, cogni-prod only
# in Vercel production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Transaction pooler URL (port 6543). prepare: false is set in code.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Private Supabase Storage buckets, created by migrations 0004 and 0006.
# Not secrets: the same names in every environment.
SUPABASE_STORAGE_BUCKET=page-assets
SUPABASE_PDF_BUCKET=page-pdfs
# Bearer for GET /api/keep-alive (Vercel Cron). At least 32 random chars:
#   openssl rand -hex 32
CRON_SECRET=
# Observability (optional locally). Server DSN and public DSN are usually equal.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
